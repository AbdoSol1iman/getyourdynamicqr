# Copy this file to .env and fill in real values.
# Never commit .env to Git.
# If your password contains special characters, URL-encode them.
# Example: '@' becomes '%40'

# Database connection string (owned by dynamicqr_user on localhost for dev).
DATABASE_URL="postgresql://dynamicqr_user:PASSWORD@localhost:5432/dynamic_qr"
# In production this points to your hosted Postgres (e.g. Neon), for example:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.neon.tech/dynamic_qr?sslmode=require"

# Port the backend listens on.
PORT=3000

# Secret used to sign JWTs. Use a long, random value in production.
JWT_SECRET=""

# Base URL used to build public QR redirect links (without trailing slash).
# Resolution priority:
#   1. BASE_URL (explicit override, e.g. a custom domain / reverse proxy)
#   2. WEBSITE_HOSTNAME — set automatically by Azure App Service -> https://<host>
#   3. http://localhost:3000 (local dev only)
# In production the app FAILS TO START if neither BASE_URL nor WEBSITE_HOSTNAME
# is set, so printed QR links can never silently point at localhost.
# Dev default: http://localhost:3000
# Production example: https://getyourdynamicqr-api-c9d2g0dsczfjenc0.francecentral-01.azurewebsites.net
BASE_URL=""

# Comma-separated list of allowed CORS origins (browser frontends).
# Leave empty in local dev to allow all origins.
# Production example: https://your-app.vercel.app,https://www.your-app.vercel.app
CORS_ORIGINS=""

# Rate limiting (requests per time window, per IP).
# Leave empty to use the defaults below.
RATE_LIMIT_API_MAX=300       # max requests / 15 minutes on all /api routes
RATE_LIMIT_AUTH_MAX=5        # max login/register attempts / 15 minutes
RATE_LIMIT_REDIRECT_MAX=120  # max QR redirects / 1 minute (generous for scanning)

# Custom domains: auto-verify on add (dev). Set to "false" in production so
# domains stay unverified until a real DNS TXT verification is implemented.
CUSTOM_DOMAIN_AUTO_VERIFY=true

# InstaPay wallet number customers pay into for plan upgrades.
# Format: 01XXXXXXX (Egyptian mobile number).
INSTAPAY_WALLET="01XXXXXXX"
